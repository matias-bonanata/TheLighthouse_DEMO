<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:VisualElement style="flex-grow: 1; max-height: 2px; background-color: rgb(0, 0, 0); height: 2px; margin-top: -3px;" />
    <ui:VisualElement class="cond-root" style="margin-top: 5px; margin-right: 5px; margin-bottom: 5px; margin-left: 0; flex-direction: row;">
        <ui:VisualElement name="LeftCol" style="flex-grow: 1; max-width: 20px; justify-content: space-between; align-items: center; min-width: 20px; width: 20px; flex-direction: column;">
            <ui:VisualElement name="OrderButtons" style="flex-grow: 1; max-height: 32px; margin-bottom: 10px;">
                <ui:VisualElement name="UpButton" style="flex-grow: 1; width: 8px; height: 8px; background-image: resource(&apos;FastStudios/ForEditor/Icons/Up&apos;); max-height: 8px; max-width: 8px; margin-bottom: 5px;" />
                <ui:VisualElement name="DownButton" style="flex-grow: 1; width: 8px; height: 8px; background-image: resource(&apos;FastStudios/ForEditor/Icons/Down&apos;); max-height: 8px; max-width: 8px;" />
            </ui:VisualElement>
            <ui:VisualElement name="LiveStatus" class="HideAlt" style="flex-grow: 1; width: 12px; height: 12px; max-height: 12px; max-width: 12px; min-width: 10px; min-height: 10px; border-top-left-radius: 3px; border-top-right-radius: 3px; border-bottom-right-radius: 3px; border-bottom-left-radius: 3px; align-self: center; margin-top: 10px; margin-bottom: 10px;" />
            <ui:VisualElement name="RemoveButton" style="flex-grow: 1; width: 10px; height: 10px; min-width: 10px; min-height: 10px; max-width: 10px; max-height: 10px; justify-content: flex-start; margin-top: 10px;">
                <ui:VisualElement name="ActualButton" style="flex-grow: 1; max-height: 2px; min-height: 2px; height: 2px; background-color: rgb(255, 255, 255); align-self: flex-start; width: 10px; margin-bottom: 5px; -unity-font-style: normal;" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="RightCol" style="flex-grow: 1;">
            <uie:PropertyField name="JoinField" binding-path="joinToNext" style="margin-top: -10px; translate: 0 -5px;" />
            <ui:VisualElement name="NormalCondition" style="flex-grow: 1;">
                <ui:VisualElement name="BindingPaths" style="flex-grow: 1; flex-direction: row;">
                    <uie:PropertyField binding-path="left" label="Left (Source)" name="leftField" class="cond-row" />
                    <ui:VisualElement name="Middle" style="align-self: flex-end; flex-direction: row; margin-left: 7px; margin-right: 4px; min-width: 72px; max-width: 140px;">
                        <ui:Label text="Magnitude" name="MagnitudeText" style="align-items: flex-start; justify-content: center; align-self: center; align-content: center; margin-right: 6px; margin-left: 4px;" />
                        <uie:PropertyField binding-path="op" label="magnitude" name="opField" class="cond-row" style="min-width: 60px;" />
                    </ui:VisualElement>
                    <uie:PropertyField binding-path="right" label="Right (Binding)" name="rightBinding" class="cond-row" style="align-self: stretch;" />
                    <ui:VisualElement name="constContainer" enabled="true" class="cond-box" style="align-self: flex-end; flex-grow: 1; min-width: 120px;">
                        <uie:PropertyField binding-path="number" name="number" class="cond-row" />
                        <uie:PropertyField binding-path="str" name="str" class="cond-row" />
                        <uie:PropertyField binding-path="boolean" name="boolean" class="cond-row" />
                        <uie:PropertyField binding-path="GameObject" name="GameObject" class="cond-row" />
                        <uie:PropertyField binding-path="obj" name="obj" class="cond-row" />
                        <uie:PropertyField binding-path="vector2" name="vector2" class="cond-row" />
                        <uie:PropertyField binding-path="vector3" name="vector3" class="cond-row" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="Lower" style="flex-grow: 1; flex-direction: row;">
                    <uie:PropertyField binding-path="RightSideDynamic" label="Dynamic" name="RightSideDynamic" class="cond-row" style="align-items: flex-start; flex-grow: 0; margin-top: 10px; margin-left: 0;" />
                    <ui:VisualElement name="KeyButton" class="cond-key-btn" style="flex-grow: 1; width: 24px; height: 24px; min-width: 24px; min-height: 24px; max-width: 24px; max-height: 24px; background-color: rgba(255, 0, 0, 0); align-self: flex-end; background-image: resource(&apos;FastStudios/ForEditor/Icons/key&apos;); background-size: 50% 50%; margin-top: 6px; border-top-left-radius: 3px; border-top-right-radius: 3px; border-bottom-right-radius: 3px; border-bottom-left-radius: 3px; margin-left: auto;" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="KeyCondition" style="flex-grow: 1;">
                <ui:VisualElement name="KeyVars" style="flex-grow: 1;">
                    <uie:PropertyField name="KeyCheckMethod" binding-path="KeyCheckMethod" />
                    <ui:VisualElement name="KeyMethods" style="flex-grow: 1; align-content: center; margin-top: 10px;">
                        <uie:PropertyField name="SpecificKey" binding-path="SpecificKey" />
                        <uie:PropertyField name="KeyName" binding-path="KeyName" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="Lower" style="flex-grow: 1; flex-direction: row; max-height: 25px;">
                    <ui:VisualElement name="KeyButton" class="cond-key-btn" style="flex-grow: 1; width: 24px; height: 24px; min-width: 24px; min-height: 24px; max-width: 24px; max-height: 24px; align-self: flex-end; background-image: resource(&apos;FastStudios/ForEditor/Icons/key&apos;); background-size: 50% 50%; margin-top: 6px; border-top-left-radius: 3px; border-top-right-radius: 3px; border-bottom-right-radius: 3px; border-bottom-left-radius: 3px; margin-left: auto;" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
