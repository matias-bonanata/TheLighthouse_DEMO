                        <editor:PropertyField binding-path="PreventDropping" label="Prevent Dropping" name="PreventDropping" style="margin-top: 10px;" />
                        <editor:PropertyField binding-path="CheckCollisionBeforePlacing" label="Check Collision Before Placing" name="CheckCollisionBeforePlacing" style="margin-top: 10px;" />
                        <editor:PropertyField binding-path="AlignNormals" label="Align With Normals" name="AlignNormals" style="margin-top: 10px;" />
                        <editor:PropertyField binding-path="VisualizeObject" label="Can Visualize Object" name="VisualizeObject" style="margin-top: 10px;" />
                        <editor:PropertyField binding-path="UseManagerMaterials" label="Use Manager Mats" name="UseManagerMaterials" style="margin-top: 10px;" />
                        <editor:PropertyField binding-path="CanRotatePlaceObject" label="Can Rotate Object" name="CanRotatePlaceObject" style="margin-top: 10px;" />
                        <editor:PropertyField binding-path="RotationAxis" label="Rotation Axis" name="RotationAxis" style="margin-top: 5px;" />
                        <editor:PropertyField binding-path="CalculateOnLocal" label="Use Local Rotation" name="CalculateOnLocal" style="margin-top: 2px;" />
                        <editor:PropertyField binding-path="OverrideTurnKeys" label="Turn Left Method" name="OverrideTurnKeys" style="margin-top: 5px;" />
                        <editor:PropertyField binding-path="NewTurnLeft" label="Turn Left Method" name="NewTurnLeft" style="margin-top: 5px;" />
                        <editor:PropertyField binding-path="NewTurnRight" label="Turn Left Mouse" name="NewTurnRight" />
