<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <engine:VisualElement name="MainImage" enabled="true" style="flex-grow: 1; max-height: 128px; background-color: rgb(91, 71, 118); height: 128px; -unity-background-scale-mode: scale-to-fit; background-image: resource(&apos;FastStudios/ForEditor/InteractableHeader_510x128&apos;); -unity-background-image-tint-color: rgb(255, 255, 255);" />
    <engine:VisualElement name="MainVars" style="flex-grow: 1;">
        <engine:VisualElement name="Upper" style="flex-grow: 1;">
            <engine:VisualElement name="Tabs" style="flex-grow: 1; min-height: auto; max-width: none; min-width: auto; flex-shrink: 0; max-height: none; flex-direction: row; margin-bottom: 10px; height: auto; margin-top: 5px;">
                <engine:Button text="Main" name="MainButton" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; min-width: auto; min-height: auto; flex-grow: 1; flex-shrink: 1; max-height: 48px; font-size: 16px; height: 24px; border-top-width: 2px; border-right-width: 0; border-bottom-width: 2px; border-left-width: 2px; border-top-left-radius: 10px; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 10px; border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0);" />
                <engine:Button text="UI" name="UIButton" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; flex-shrink: 1; flex-grow: 1; max-height: 48px; font-size: 16px; height: 24px; border-top-width: 2px; border-right-width: 0; border-bottom-width: 2px; border-left-width: 0; border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0; border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0);" />
                <engine:Button text="Events" name="EventsButton" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; flex-shrink: 1; flex-grow: 1; max-height: 48px; font-size: 16px; height: 24px; border-top-width: 2px; border-right-width: 0; border-bottom-width: 2px; border-left-width: 0; border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0; border-bottom-color: rgb(0, 0, 0); border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0);" />
                <engine:Button text="Settings" name="SettingsButton" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; flex-shrink: 1; flex-grow: 1; max-height: 48px; font-size: 16px; height: 24px; border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 0; border-top-left-radius: 0; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 0; border-bottom-color: rgb(0, 0, 0); border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0);" />
            </engine:VisualElement>
            <engine:EnumField label="Type" value="UnityEvent" type="FastStudios.InteractMode, Assembly-CSharp" binding-path="interactMode" name="interactMode" tabindex="100" style="margin-top: 0; margin-right: 0; margin-bottom: 10px; margin-left: 0;" />
        </engine:VisualElement>
        <engine:VisualElement name="Lower" style="flex-grow: 1; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0); border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px;">
            <engine:VisualElement name="UnityEventTab" enabled="true" tabindex="1" style="flex-grow: 1;">
                <editor:PropertyField name="UnityEventField" binding-path="unityEventToTrigger" label="Event To Trigger" />
            </engine:VisualElement>
            <engine:VisualElement name="HoldTab" enabled="true" tabindex="2" style="flex-grow: 1;">
                <editor:PropertyField name="holdTime" binding-path="holdTime" label="Hold Time" style="margin-bottom: 5px;" />
                <editor:PropertyField name="releaseToCancel" binding-path="releaseToCancel" label="Release Key To Cancel" style="margin-bottom: 10px;" />
                <editor:PropertyField name="UnityEventField" binding-path="unityEventToTrigger" label="Event To Trigger" />
                <engine:VisualElement name="HoldLimit" style="flex-grow: 1; margin-top: 10px;">
                    <engine:VisualElement name="HoldLimitFoldout" style="flex-grow: 1; max-height: 32px; background-color: rgb(77, 77, 77); border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0); border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; margin-left: 10px; margin-right: 5px; border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px; height: 32px;">
                        <engine:Label text="Hold Limit" style="font-size: 20px; padding-left: 2px; left: 15px; right: auto; flex-shrink: 1; flex-wrap: wrap; width: 88px;" />
                    </engine:VisualElement>
                    <engine:VisualElement name="HoldLimitContainer" style="flex-grow: 0; max-height: none; background-color: rgb(77, 77, 77); border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0); border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; margin-left: 30px; margin-right: 30px; border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px; flex-shrink: 1; min-height: auto; margin-top: -2px; padding-right: 10px; padding-top: 10px; padding-bottom: 10px; padding-left: 10px;">
                        <editor:PropertyField binding-path="hasMaxHoldInteractions" label="Has Max Hold Interactions" name="hasMaxHoldInteractions" style="margin-top: 0;" />
                        <editor:PropertyField binding-path="maxHoldInteractions" label="Max Hold Interactions" name="maxHoldInteractions" style="margin-top: 3px;" />
                    </engine:VisualElement>
                </engine:VisualElement>
            </engine:VisualElement>
            <engine:VisualElement name="GrabTab" enabled="true" tabindex="3" style="flex-grow: 1; flex-direction: column;">
                <editor:PropertyField binding-path="GrabId" label="Grab ID" name="GrabId" style="margin-top: -7px; margin-bottom: 10px;" />
                <engine:VisualElement name="Distance" style="flex-grow: 1;">
                    <engine:VisualElement name="DistanceFoldout" style="flex-grow: 1; max-height: 32px; background-color: rgb(77, 77, 77); border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0); border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; margin-left: 10px; margin-right: 5px; border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px; height: 32px;">
                        <engine:Label text="Distance" style="font-size: 20px; padding-left: 2px; left: 15px; right: auto; flex-shrink: 1; flex-wrap: wrap; width: 88px;" />
                    </engine:VisualElement>
                    <engine:VisualElement name="DistanceContainer" style="flex-grow: 0; max-height: none; background-color: rgb(77, 77, 77); border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0); border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; margin-left: 30px; margin-right: 30px; border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px; flex-shrink: 1; min-height: auto; margin-top: -2px; padding-right: 10px; padding-top: 10px; padding-bottom: 10px; padding-left: 10px;">
                        <editor:PropertyField binding-path="GrabDistance" label="Distance" name="GrabDistance" style="margin-top: 0;" />
                        <editor:PropertyField binding-path="GrabOffset" label="Offset" name="GrabOffset" style="margin-top: 0;" />
                        <editor:PropertyField binding-path="ScrolledBasedDistance" label="Scrolled Based Distance" name="ScrolledBasedDistance" style="margin-top: 10px;" />
                        <editor:PropertyField binding-path="ScrollMultiplier" label="Scroll Multiplier" name="ScrollMultiplier" style="margin-top: 2px; margin-bottom: 2px;" />
                        <editor:PropertyField binding-path="GrabDistanceMinMax" label="Grab Distance MinMax" name="GrabDistanceMinMax" style="margin-top: 4px;" />
                    </engine:VisualElement>
                </engine:VisualElement>
                <engine:VisualElement name="Physics" style="flex-grow: 1; margin-top: 10px;">
                    <engine:VisualElement name="PhysicsFoldout" style="flex-grow: 1; max-height: 32px; background-color: rgb(77, 77, 77); border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0); border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; margin-left: 10px; margin-right: 5px; border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px; height: 32px;">
                        <engine:Label text="Physics" style="font-size: 20px; padding-left: 2px; left: 15px; right: auto; flex-shrink: 1; flex-wrap: wrap; width: 88px;" />
                    </engine:VisualElement>
                    <engine:VisualElement name="PhysicsContainer" style="flex-grow: 0; max-height: none; background-color: rgb(77, 77, 77); border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0); border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; margin-left: 30px; margin-right: 30px; border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px; flex-shrink: 1; min-height: auto; margin-top: -2px; padding-right: 10px; padding-top: 10px; padding-bottom: 10px; padding-left: 10px;">
                        <editor:PropertyField binding-path="PhysicsGrabMode" label="Physics Mode" name="PhysicsGrabMode" />
                        <editor:PropertyField binding-path="PlayerHelperForce" label="Player Helper Force" name="PlayerHelperForce" />
                        <editor:PropertyField binding-path="linearDamping" label="Linear Damping" name="linearDamping" />
                        <editor:PropertyField binding-path="angularDamping" label="Angular Damping" name="angularDamping" />
                    </engine:VisualElement>
                </engine:VisualElement>
                <engine:VisualElement name="CanPlace" style="flex-grow: 1; margin-top: 10px;">
                    <engine:VisualElement name="CanPlaceFoldout" style="flex-grow: 1; max-height: 32px; background-color: rgb(77, 77, 77); border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0); border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; margin-left: 10px; margin-right: 5px; border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px; height: 32px;">
                        <engine:Label text="Can Place" style="font-size: 20px; padding-left: 2px; left: 15px; right: auto; flex-shrink: 1; flex-wrap: wrap; width: 88px;" />
                    </engine:VisualElement>
                    <engine:VisualElement name="CanPlaceContainer" style="flex-grow: 0; max-height: none; background-color: rgb(77, 77, 77); border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0); border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; margin-left: 30px; margin-right: 30px; border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px; flex-shrink: 1; min-height: auto; margin-top: -2px; padding-right: 10px; padding-top: 10px; padding-bottom: 10px; padding-left: 10px;">
