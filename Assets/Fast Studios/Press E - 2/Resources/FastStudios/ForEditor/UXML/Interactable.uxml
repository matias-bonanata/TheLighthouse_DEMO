                        <editor:PropertyField binding-path="RotationIncrement" label="Increment" name="RotationIncrement" />
                    </engine:VisualElement>
                </engine:VisualElement>
                <engine:VisualElement name="CanGrabRotate" style="flex-grow: 1; margin-top: 10px;">
                    <engine:VisualElement name="CanGrabRotateFoldout" style="flex-grow: 1; max-height: 32px; background-color: rgb(77, 77, 77); border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0); border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; margin-left: 10px; margin-right: 5px; border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px; height: 32px;">
                        <engine:Label text="Can Rotate" style="font-size: 20px; padding-left: 2px; left: 15px; right: auto; flex-shrink: 1; flex-wrap: wrap; width: 88px;" />
                    </engine:VisualElement>
                    <engine:VisualElement name="CanGrabRotateContainer" style="flex-grow: 0; max-height: none; background-color: rgb(77, 77, 77); border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0); border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; margin-left: 30px; margin-right: 30px; border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px; flex-shrink: 1; min-height: auto; margin-top: -2px; padding-right: 10px; padding-top: 10px; padding-bottom: 10px; padding-left: 10px;">
                        <editor:PropertyField binding-path="CanRotateGrab" label="Enabled" name="CanRotateGrab" />
                        <editor:PropertyField binding-path="RotationSensitivity" label="Sensitivity" name="RotationSensitivity" style="margin-top: 5px;" />
                        <editor:PropertyField binding-path="OverrideGrabRotateKeys" label="Override Grab Rotation Key" name="OverrideGrabRotateKeys" style="margin-top: 3px;" />
                        <editor:PropertyField binding-path="NewGrabRotation" label="Input Method" name="NewGrabRotation" />
                        <editor:PropertyField binding-path="GrabShowCursorWhenRotating" label="Show Cursor When Rotating" name="GrabShowCursorWhenRotating" style="margin-top: 3px;" />
                        <editor:PropertyField binding-path="GrabDontHideCursorOnStop" label="Dont Hide Cursor On Stop" name="GrabDontHideCursorOnStop" style="margin-top: 3px;" />
                    </engine:VisualElement>
                </engine:VisualElement>
                <engine:VisualElement name="TransformBased" style="flex-grow: 1; margin-top: 10px;">
                    <engine:VisualElement name="TransformBasedFoldout" style="flex-grow: 1; max-height: 32px; background-color: rgb(77, 77, 77); border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0); border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; margin-left: 10px; margin-right: 5px; border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px; height: 32px;">
                        <engine:Label text="Transform" style="font-size: 20px; padding-left: 2px; left: 15px; right: auto; flex-shrink: 1; flex-wrap: wrap; width: 88px;" />
                    </engine:VisualElement>
                    <engine:VisualElement name="TransformBasedContainer" style="flex-grow: 0; max-height: none; background-color: rgb(77, 77, 77); border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0); border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; margin-left: 30px; margin-right: 30px; border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px; flex-shrink: 1; min-height: auto; margin-top: -2px; padding-right: 10px; padding-top: 10px; padding-bottom: 10px; padding-left: 10px;">
