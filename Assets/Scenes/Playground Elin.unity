--- !u!114 &1293392050
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1293392048}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 83189876d4d389f43b7dd2e925aa112e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  CurrentIDCounter: 82
  json: "{\"Options\":[{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":11}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-82.5,\"yPos\":-216},\"ID\":8,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"don't
    call me boy.\",\"parentUIDs\":[7],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":12}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":221.5,\"yPos\":-217},\"ID\":9,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"how
    can you tell?\",\"parentUIDs\":[7],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":13}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":771.5,\"yPos\":-206},\"ID\":10,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"there's
    a storm coming?\",\"parentUIDs\":[7,16],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":21}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-583.5,\"yPos\":103},\"ID\":18,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"I
    *am* fit to do this job.\",\"parentUIDs\":[17],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":32}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-315.5,\"yPos\":104},\"ID\":19,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Sounds
    fair.\",\"parentUIDs\":[17],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":34}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-92.5,\"yPos\":102},\"ID\":20,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Whatever
    you say, old man.\",\"parentUIDs\":[17],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":25}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-593.5,\"yPos\":397},\"ID\":24,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"What
    kind of person is the *type* for it?\",\"parentUIDs\":[22],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":28}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-591.5,\"yPos\":575},\"ID\":27,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Well?\",\"parentUIDs\":[25],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":31}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-592.5,\"yPos\":757},\"ID\":30,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"...\",\"parentUIDs\":[28,33,41,44,52,62,72,79,81],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":37}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-84.5,\"yPos\":397},\"ID\":36,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Like
    what?\",\"parentUIDs\":[35],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":40}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":54.5,\"yPos\":582},\"ID\":38,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"What
    mistakes?\",\"parentUIDs\":[37],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":42}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-167.5,\"yPos\":582},\"ID\":39,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Stories?\",\"parentUIDs\":[37,48],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":47}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":190.5,\"yPos\":113},\"ID\":46,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"How
    can I learn to do that?\",\"parentUIDs\":[16],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":51}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":641.5,\"yPos\":199},\"ID\":49,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Thanks
    for the tip.\",\"parentUIDs\":[15],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":53}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":895.5,\"yPos\":199},\"ID\":50,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Do
    you have anything else to teach me?\",\"parentUIDs\":[15],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":58}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":888.5,\"yPos\":598},\"ID\":57,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"You'll
    come and see me?\",\"parentUIDs\":[55],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":61}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":761.5,\"yPos\":799},\"ID\":59,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Sure.\",\"parentUIDs\":[58],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":63}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":1031.5,\"yPos\":797},\"ID\":60,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Equipment?\",\"parentUIDs\":[58],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":67}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":905.5,\"yPos\":1008},\"ID\":64,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Thank
    you. That *was* kind of you.\",\"parentUIDs\":[63],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":73}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":1132.5,\"yPos\":1007},\"ID\":65,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Do
    I owe you?\",\"parentUIDs\":[63],\"SpeechUID\":-1},{\"Connections\":[],\"EditorInfo\":{\"isRoot\":false,\"xPos\":1360.5,\"yPos\":1006},\"ID\":66,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"You
    didn't happen to leave any cigarettes, did you?\",\"parentUIDs\":[63],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":71}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":902.5,\"yPos\":1282},\"ID\":70,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Angelic?\",\"parentUIDs\":[69],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":76}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":1143.5,\"yPos\":1198},\"ID\":74,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"That's
    not fair!\",\"parentUIDs\":[73],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":80}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":1373.5,\"yPos\":1196},\"ID\":75,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Sounds
    fair.\",\"parentUIDs\":[73],\"SpeechUID\":-1}],\"Parameters\":[],\"SpeechNodes\":[{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":7}],\"EditorInfo\":{\"isRoot\":true,\"xPos\":214.5,\"yPos\":-435},\"ID\":0,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"*You
    are sitting on a boat, a fishing trawler. An old, grizzled fisherman sits nearby,
    steering the rudder gently. He [[chats to you]] as the trawler navigates through
    the mist.*\",\"parentUIDs\":[],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0.726},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":8},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":9},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":10}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":215.5,\"yPos\":-327},\"ID\":7,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"There\u2019s
    a strange wind on these shores today. Rising from the south, I reckon. Best mind
    yourself tonight, boy - that old wreck is in no condition to protect you from
    a real storm.\",\"parentUIDs\":[0],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"TROSS\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":17}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-118.5,\"yPos\":-116},\"ID\":11,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"*The
    old man barks a laugh. You glimpse the mottled yellow tombstones of his teeth.*\\r\",\"parentUIDs\":[8],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":16}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":220.5,\"yPos\":-119},\"ID\":12,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"*Tross
    squints out at the horizon, his hand drifting to one of the carved amulets around
    his neck. He breathes in the breeze.*\\r\",\"parentUIDs\":[9],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":14}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":770.5,\"yPos\":-131},\"ID\":13,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Aye,
    boy. They form over the great sea and travel east, getting stronger as they go.
    The mist feeds 'em. Makes them crackle with lightning. You ever seen a mist storm?
    A big one? Dim flashes in the grey, until you're in the heart of it and the grey
    explodes around you. Nothing to worry about unless the hair on the back of your
    neck rises.\",\"parentUIDs\":[10],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"TROSS\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":15}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":768.5,\"yPos\":-20},\"ID\":14,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"*He
    laughs and claps you on the shoulder.*\",\"parentUIDs\":[13],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":49},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":50}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":768.5,\"yPos\":86},\"ID\":15,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"That's
    when you run, boy. You hear me?\",\"parentUIDs\":[14],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"TROSS\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":46},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":10}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":227.5,\"yPos\":-8},\"ID\":16,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"I've
    fished these shores for sixty years. Rains, typhoons, snows. Long summers where
    the mist was so hot you didn't know the fog from your own evaporated sweat. You
    get to be able to read the mist's moods like a broadcast signal. I'll leave the
    signals to you, boy, and take my forecasts from the wind.\",\"parentUIDs\":[12],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"TROSS\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":18},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":19},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":20}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-116.5,\"yPos\":1},\"ID\":17,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"You've
    still got feather-down on your chin, boy. When you've lived as long as I have,
    all the younger generation are yet weans to dandle on your knee. Until you've
    proven you're fit to do this job, and do it well, you're a boy in my eyes.\",\"parentUIDs\":[11],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"TROSS\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":22}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-591.5,\"yPos\":178},\"ID\":21,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"*Tross
    keeps his attention on the blank wall of mist.*\\r\",\"parentUIDs\":[18],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":24}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-593.5,\"yPos\":292},\"ID\":22,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"I
    hope so, boy. It's a lot of doing. You're needed, right enough, but it's a lonely
    thing staying out here. There's a type for it and not everyone has the constitution.
    I don't envy ye, that's for sure.\",\"parentUIDs\":[21],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"TROSS\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":27}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-593.5,\"yPos\":474},\"ID\":25,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Someone
    secure. Happy in their head. Makes work for themselves when the day's tough labour
    is done. And the most important bit, well...\",\"parentUIDs\":[24],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"TROSS\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":30}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-589.5,\"yPos\":653},\"ID\":28,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"To
    do this job, and do it well, you can't be bringing your ghosts with you. There's
    no room for them, not where you're going. You're not running from anything, are
    you?\",\"parentUIDs\":[27],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"TROSS\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[],\"EditorInfo\":{\"isRoot\":false,\"xPos\":89.5,\"yPos\":1245},\"ID\":31,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"See
    that? We're nearly there, boy. Can you see it?\",\"parentUIDs\":[30],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"TROSS\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":33}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-314.5,\"yPos\":175},\"ID\":32,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Good
    man. That's the attitude. Keep that up and I'll toss something nice in when I
    come and see you next.\",\"parentUIDs\":[19],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"TROSS\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":30}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-335.5,\"yPos\":481},\"ID\":33,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"*You
    smile, fiddle with your uniform, and look out at the mist in silence.*\",\"parentUIDs\":[32],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":35}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-82.5,\"yPos\":172},\"ID\":34,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"*Grinning,
    Tross puts something in his mouth and worrys it with his teeth. It might be a
    fishbone.*\",\"parentUIDs\":[20],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":36}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-83.5,\"yPos\":285},\"ID\":35,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"I
    like ye, boy, but you could do with opening those ears up some. There's plenty
    to be learning from folk around here.\",\"parentUIDs\":[34],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"TROSS\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":38},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":39}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-83.5,\"yPos\":476},\"ID\":37,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Oh,
    all sorts. People in these parts are different to your mainlanders. You lot are
    all about moving forward, modernising, looking to the future. Out here in the
    islands, we stick to the old ways, listen to the land and the sea, tell the old
    stories. There's a lot to be learned from the mistakes of the past.\",\"parentUIDs\":[36],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"TROSS\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":41}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":81.5,\"yPos\":665},\"ID\":40,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Boy,
    if you don't agree that our ancestors made some serious errors in judgement,
    you'd best come to some smarter conclusions. Fortunately, once I leave you to
    yourself you'll have plenty of time to think.\",\"parentUIDs\":[38],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"TROSS\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":30}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":86.5,\"yPos\":1132},\"ID\":41,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"*You
    sit in uncomfortable silence.*\",\"parentUIDs\":[40],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":43}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-163.5,\"yPos\":659},\"ID\":42,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Aye,
    yeah, all sorts. You hear things from fishermen, net-gatherers, the folk of the
    shore. Distant lights out beyond the bay when the mist clears. Voices in the
    fog, luring the unwary out to heaven-knows-where, and they never come back. Some
    say there's an island out there where the sun always shines, and the mist just
    skirts around it. Out west, they whisper, out past the edge of the map. I've
    never tried to find it myself, but plenty have gone looking. I've heard tell
    of phantom ships on the trading routes, sending signals in strange tongues...\",\"parentUIDs\":[39],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"TROSS\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":44}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-163.5,\"yPos\":760},\"ID\":43,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"The
    mist plays tricks on the mind, and you've got to be more careful than most, boy.
    Being alone for so long, it's not wise. I told them to send someone with you,
    so the pair of ye could mind each other, but the militia wouldn't listen to an
    old sea-trawler like me.\\r\\nWatch yourself. I'd hate to turn up on your doorstep
    to find ye missing with the table still laid and the mist pouring in the open
    windows.\",\"parentUIDs\":[42],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"TROSS\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":30}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-159.5,\"yPos\":850},\"ID\":44,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"*You
    don't know how to answer that, so you mull over his words in silence.*\",\"parentUIDs\":[43],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":48}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":189.5,\"yPos\":208},\"ID\":47,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Give
    it time, eh? You'll come to be familar with the mist, the sea, the wind. The
    main thing is to listen. You might think the mist is dead, a blank white wall,
    but if you shut your trap for a bit it'll show you its different... what's the
    word? Aspects. Despite what you might think, these mists we live in are always
    changing. There are stories, aye, I heard stories...\",\"parentUIDs\":[46],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"TROSS\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":39}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":194.5,\"yPos\":313},\"ID\":48,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"*He
    tails off, listening, his mind elsewhere.*\",\"parentUIDs\":[47],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":52}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":628.5,\"yPos\":278},\"ID\":51,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"I
    see they teach you manners on the mainland. If nothing else!\",\"parentUIDs\":[49],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"TROSS\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":30}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":632.5,\"yPos\":388},\"ID\":52,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"*He
    laughs, then starts to cough, wiping the phlegm on his sleeve. You look away
    politely and lapse into silence.*\",\"parentUIDs\":[51],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":54}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":890.5,\"yPos\":283},\"ID\":53,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"*Tross
    winks. At least, you think he did. His eyes are so wrinkled and half-lidded against
    the wind it's hard to tell.*\",\"parentUIDs\":[50],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":55}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":895.5,\"yPos\":393},\"ID\":54,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Aye.
    Plenty. But I can't be giving you all my wisdom from the off. You'll be seeing
    a lot of me, boy, and I cannae risk ye getting bored.\",\"parentUIDs\":[53],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"TROSS\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":57}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":890.5,\"yPos\":495},\"ID\":55,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"*He
    laughs and adjusts the rudder.*\",\"parentUIDs\":[54],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":59},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":60}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":889.5,\"yPos\":677},\"ID\":58,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Someone's
    got to bring ye your vittles and equipment and that. I'll be back when you need
    me. This is the beginning of a beautiful friendship, boy.\",\"parentUIDs\":[57],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"TROSS\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":62}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":617.5,\"yPos\":864},\"ID\":61,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"*The
    old fisherman smiles, crinkling his face. The glance he gives you is knowing,
    appraising and humorous all at once. He's been weighing you up. You're not sure
    he likes what he sees.*\\r\",\"parentUIDs\":[59],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":30}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":362.5,\"yPos\":866},\"ID\":62,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"*The
    two of you settle into silence.*\",\"parentUIDs\":[61],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":64},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":65},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":66}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":1027.5,\"yPos\":873},\"ID\":63,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"The
    place is a ruin. I was kind enough to take a look and see what materials you
    might need to start fixing it up. They're waiting for you there.\",\"parentUIDs\":[60],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"TROSS\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":69}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":898.5,\"yPos\":1082},\"ID\":67,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"*Tross
    shakes his head.*\",\"parentUIDs\":[64],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":70}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":904.5,\"yPos\":1182},\"ID\":69,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"I'm
    the picture of angelic compassion, I am.\",\"parentUIDs\":[67],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"TROSS\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":72}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":643.5,\"yPos\":1271},\"ID\":71,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Never
    heard of an angel? No? Old stories, old times. I suppose you wouldn't have. The
    militia has no call for filling your heads with nonsense. Ignore me, boy. I'm
    an old man repeating the tales of old men.\",\"parentUIDs\":[70],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"TROSS\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":30}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":412.5,\"yPos\":1275},\"ID\":72,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"*He's
    lost in thought, gripping a talisman strung around his neck on rawhide cord.\\r\\nYou
    leave him to his memories and listen to the silence.*\",\"parentUIDs\":[71],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":74},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":75}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":1131.5,\"yPos\":1087},\"ID\":73,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Consider
    it your first month's payment. And maybe your second month, too.\",\"parentUIDs\":[65],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"TROSS\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":78}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":1141.5,\"yPos\":1349},\"ID\":76,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"*Tross's
    hand keeps adjusting the rudder. He's still gazing out into the nothingness,
    following an invisible path through the waves.*\",\"parentUIDs\":[74],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":79}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":1136.5,\"yPos\":1456},\"ID\":78,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Nothing's
    fair, boy. That's why you're here, no?\",\"parentUIDs\":[76],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"TROSS\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":30}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-493.5,\"yPos\":1294},\"ID\":79,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"*You
    bite back an angry retort and sit in stony silence.*\",\"parentUIDs\":[78],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":81}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":1377.5,\"yPos\":1546},\"ID\":80,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Good
    man. That's the attitude. Keep that up and I'll toss something nice in when I
    come and see you next.\",\"parentUIDs\":[75],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"TROSS\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":30}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-619.5,\"yPos\":1380},\"ID\":81,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"*You
    smile, fiddle with your uniform, and look out at the mist in silence.*\",\"parentUIDs\":[80],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0}]}"
